{
  "functions": [
    {
      "source": "functions",
      "codebase": "driver_push",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firebase.test.json",
      "firestore.rules",
      "firestore.indexes.json",
      "firebase.json.backup",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "!functions/driver-services.mjs",
      "tests/**",
      "scripts/**",
      "docs/**",
      ".github/**",
      "*.md",
      "*.before-*",
      "**/*.before-*",
      "*.log",
      "package.json",
      "tailwind.config.cjs",
      "SameOriginStreet*"
    ]
  }
}
