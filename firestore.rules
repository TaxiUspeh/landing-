// Такси Успех · v53 · 09.09.2026 · Индивидуальная комиссия и лимиты долга
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminDocument() {
      return /databases/$(database)/documents/admins/$(request.auth.uid);
    }

    function isAdmin() {
      return signedIn()
        && exists(adminDocument())
        && get(adminDocument()).data.active == true;
    }

    function driverAccountDocument() {
      return /databases/$(database)/documents/driverAccounts/$(request.auth.uid);
    }

    function driverStateDocument() {
      return /databases/$(database)/documents/driverStates/$(request.auth.uid);
    }

    function hasDriverAccount() {
      return signedIn() && exists(driverAccountDocument());
    }

    function linkedDriverId() {
      return get(driverAccountDocument()).data.driverId;
    }

    function isLinkedDriver(driverId) {
      return hasDriverAccount() && linkedDriverId() == driverId;
    }

    function linkedDriverDocument() {
      return /databases/$(database)/documents/drivers/$(linkedDriverId());
    }

    function mayOpenOrders() {
      return hasDriverAccount()
        && get(driverAccountDocument()).data.active == true
        && exists(linkedDriverDocument())
        && get(linkedDriverDocument()).data.status == 'active';
    }

    function activeOrderStatus(status) {
      return status == 'accepted'
        || status == 'en_route'
        || status == 'arrived'
        || status == 'in_trip';
    }

    function driverIsAvailable() {
      return mayOpenOrders()
        && hasOrderFunds(get(linkedDriverDocument()).data)
        && exists(driverStateDocument())
        && get(driverStateDocument()).data.driverId == linkedDriverId()
        && get(driverStateDocument()).data.status == 'available'
        && get(driverStateDocument()).data.activeOrderId == ''
        && get(driverStateDocument()).data.lastSeen is timestamp;
    }

    function driverIsBusyWithOrder(orderId) {
      return hasDriverAccount()
        && exists(driverStateDocument())
        && get(driverStateDocument()).data.driverId == linkedDriverId()
        && get(driverStateDocument()).data.status == 'busy'
        && get(driverStateDocument()).data.activeOrderId == orderId;
    }

    function driverBecomesBusyWithOrder(orderId) {
      return existsAfter(driverStateDocument())
        && getAfter(driverStateDocument()).data.driverId == linkedDriverId()
        && getAfter(driverStateDocument()).data.status == 'busy'
        && getAfter(driverStateDocument()).data.activeOrderId == orderId
        && getAfter(driverStateDocument()).data.lastSeen == request.time
        && getAfter(driverStateDocument()).data.updatedAt == request.time;
    }

    function driverBecomesAvailableAfter(orderId) {
      return existsAfter(driverStateDocument())
        && getAfter(driverStateDocument()).data.driverId == linkedDriverId()
        && getAfter(driverStateDocument()).data.status == 'available'
        && getAfter(driverStateDocument()).data.activeOrderId == ''
        && getAfter(driverStateDocument()).data.lastSeen == request.time
        && getAfter(driverStateDocument()).data.updatedAt == request.time
        && existsAfter(orderDocument(orderId))
        && (getAfter(orderDocument(orderId)).data.status == 'completed'
          || getAfter(orderDocument(orderId)).data.status == 'cancelled');
    }

    function driverBecomesAvailableAfterRequeue(orderId) {
      let stateAfter = getAfter(driverStateDocument()).data;
      let orderAfter = getAfter(orderDocument(orderId)).data;
      return existsAfter(driverStateDocument())
        && stateAfter.driverId == linkedDriverId()
        && stateAfter.status == 'available'
        && stateAfter.activeOrderId == ''
        && stateAfter.lastSeen == request.time
        && stateAfter.updatedAt == request.time
        && existsAfter(orderDocument(orderId))
        && orderAfter.status in ['searching', 'bidding']
        && orderAfter.assignedDriverUid == ''
        && orderAfter.assignedDriverId == ''
        && orderAfter.driverName == ''
        && orderAfter.driverPhone == ''
        && orderAfter.driverCar == ''
        && orderAfter.driverColor == ''
        && orderAfter.requeuedAt == request.time;
    }

    function orderDocument(orderId) {
      return /databases/$(database)/documents/orders/$(orderId);
    }

    function driverDocument(driverId) {
      return /databases/$(database)/documents/drivers/$(driverId);
    }

    function onlineCommissionHistoryDocument(orderId) {
      return /databases/$(database)/documents/balanceHistory/$(orderId);
    }

    function commissionBaseAmountForOrder(orderId) {
      return getAfter(orderDocument(orderId)).data.priceAmount;
    }

    function commissionRateForOrder(orderId) {
      let terms = get(orderDocument(orderId)).data.get('commissionTerms', null);
      return terms == null ? 20 : terms.rate;
    }

    function commissionAmountForOrder(orderId) {
      let terms = get(orderDocument(orderId)).data.get('commissionTerms', null);
      return terms == null ? commissionBaseAmountForOrder(orderId) / 5 : terms.amount;
    }

    // Проверяет поля завершённого онлайн-заказа и связанное изменение баланса.
    // Эта проверка намеренно не требует запись истории: правило создания истории
    // использует её же, а сам заказ ниже отдельно требует наличие истории в той же
    // атомарной операции.
    function validCommissionOrderAndBalance(orderId, driverId) {
      return existsAfter(orderDocument(orderId))
        && getAfter(orderDocument(orderId)).data.status == 'completed'
        && (getAfter(orderDocument(orderId)).data.assignedDriverUid == request.auth.uid || isAdmin())
        && getAfter(orderDocument(orderId)).data.assignedDriverId == driverId
        && getAfter(orderDocument(orderId)).data.commissionRate == commissionRateForOrder(orderId)
        && getAfter(orderDocument(orderId)).data.commissionBaseAmount is number
        && getAfter(orderDocument(orderId)).data.commissionBaseAmount == commissionBaseAmountForOrder(orderId)
        && getAfter(orderDocument(orderId)).data.commissionAmount is number
        && getAfter(orderDocument(orderId)).data.commissionAmount == commissionAmountForOrder(orderId)
        && getAfter(orderDocument(orderId)).data.commissionBalanceBefore is number
        && getAfter(orderDocument(orderId)).data.commissionBalanceAfter is number
        && getAfter(orderDocument(orderId)).data.commissionChargedAt == request.time
        && exists(driverDocument(driverId))
        && existsAfter(driverDocument(driverId))
        && get(driverDocument(driverId)).data.balance is number
        && getAfter(driverDocument(driverId)).data.balance is number
        && getAfter(orderDocument(orderId)).data.commissionBalanceBefore == get(driverDocument(driverId)).data.balance
        && getAfter(orderDocument(orderId)).data.commissionBalanceAfter == getAfter(driverDocument(driverId)).data.balance
        && getAfter(driverDocument(driverId)).data.lastCommissionOrderId == orderId
        && getAfter(driverDocument(driverId)).data.updatedAt == request.time;
    }

    function validCommissionSettlement(orderId, driverId) {
      return validCommissionOrderAndBalance(orderId, driverId)
        && existsAfter(onlineCommissionHistoryDocument(orderId));
    }

    function validOwnOnlineCommissionHistoryCreate(entryId) {
      return hasDriverAccount()
        && entryId == request.resource.data.orderId
        && request.resource.data.keys().hasOnly([
          'driverId', 'driverNumber', 'orderId', 'orderNumber', 'source',
          'commissionRate', 'commissionBaseAmount', 'commissionAmount', 'previousBalance', 'newBalance',
          'difference', 'reason', 'changedAt', 'changedBy'
        ])
        && request.resource.data.driverId == linkedDriverId()
        && request.resource.data.driverNumber == getAfter(linkedDriverDocument()).data.driverNumber
        && request.resource.data.orderId is string
        && request.resource.data.orderId.size() > 0
        && request.resource.data.orderNumber is string
        && request.resource.data.orderNumber.size() <= 32
        && request.resource.data.source == 'online'
        && request.resource.data.commissionRate == commissionRateForOrder(request.resource.data.orderId)
        && request.resource.data.commissionBaseAmount is number
        && request.resource.data.commissionAmount is number
        && request.resource.data.previousBalance is number
        && request.resource.data.newBalance is number
        && request.resource.data.difference is number
        && request.resource.data.reason == (getAfter(orderDocument(request.resource.data.orderId)).data.get('auctionRound', 0) > 0
          ? 'Комиссия ' + string(commissionRateForOrder(request.resource.data.orderId)) + '% от согласованной цены аукциона' : 'Комиссия ' + string(commissionRateForOrder(request.resource.data.orderId)) + '% от максимальной цены онлайн-заказа')
        && request.resource.data.changedAt == request.time
        && request.resource.data.changedBy == request.auth.uid
        && request.resource.data.commissionBaseAmount == commissionBaseAmountForOrder(request.resource.data.orderId)
        && request.resource.data.commissionAmount == commissionAmountForOrder(request.resource.data.orderId)
        && request.resource.data.difference == request.resource.data.commissionAmount
        && request.resource.data.previousBalance == get(driverDocument(linkedDriverId())).data.balance
        && request.resource.data.newBalance == getAfter(driverDocument(linkedDriverId())).data.balance
        && validCommissionOrderAndBalance(request.resource.data.orderId, linkedDriverId());
    }

    function driverAppliesOwnOnlineCommission(driverId) {
      return isLinkedDriver(driverId)
        && resource.data.balance is number
        && request.resource.data.balance is number
        && request.resource.data.lastCommissionOrderId is string
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'balance', 'lastCommissionOrderId', 'updatedAt'
        ])
        && validCommissionOrderAndBalance(request.resource.data.lastCommissionOrderId, driverId)
        && request.resource.data.balance == resource.data.balance
          + commissionAmountForOrder(request.resource.data.lastCommissionOrderId);
    }

    function validDriverStateData(data) {
      return data.keys().hasOnly([
          'driverId', 'status', 'activeOrderId', 'lastSeen', 'updatedAt'
        ])
        && data.driverId is string
        && data.driverId == linkedDriverId()
        && data.status is string
        && data.status in ['offline', 'available', 'busy']
        && data.activeOrderId is string
        && data.activeOrderId.size() <= 128
        && ((data.status == 'busy' && data.activeOrderId.size() > 0)
          || (data.status != 'busy' && data.activeOrderId == ''))
        && data.lastSeen == request.time
        && data.updatedAt == request.time;
    }

    function validOwnDriverStateCreate() {
      return hasDriverAccount()
        && validDriverStateData(request.resource.data)
        && (request.resource.data.status == 'offline'
          || (request.resource.data.status == 'available' && mayOpenOrders())
          || (request.resource.data.status == 'busy'
            && exists(orderDocument(request.resource.data.activeOrderId))
            && get(orderDocument(request.resource.data.activeOrderId)).data.assignedDriverUid == request.auth.uid
            && activeOrderStatus(get(orderDocument(request.resource.data.activeOrderId)).data.status)));
    }

    function validOwnDriverStateUpdate() {
      return hasDriverAccount()
        && resource.data.driverId == linkedDriverId()
        && validDriverStateData(request.resource.data)
        && (
          (request.resource.data.status == resource.data.status
            && request.resource.data.activeOrderId == resource.data.activeOrderId
            && (resource.data.status != 'available' || mayOpenOrders()))
          || (resource.data.status == 'offline'
            && request.resource.data.status == 'available'
            && mayOpenOrders())
          || (resource.data.status == 'available'
            && request.resource.data.status == 'offline')
          || (resource.data.status == 'available'
            && resource.data.activeOrderId == ''
            && request.resource.data.status == 'busy'
            && existsAfter(orderDocument(request.resource.data.activeOrderId))
            && getAfter(orderDocument(request.resource.data.activeOrderId)).data.assignedDriverUid == request.auth.uid
            && activeOrderStatus(getAfter(orderDocument(request.resource.data.activeOrderId)).data.status))
          || (resource.data.status == 'busy'
            && request.resource.data.status == 'available'
            && request.resource.data.activeOrderId == ''
            && existsAfter(orderDocument(resource.data.activeOrderId))
            && (getAfter(orderDocument(resource.data.activeOrderId)).data.status == 'completed'
              || getAfter(orderDocument(resource.data.activeOrderId)).data.status == 'cancelled'
              || driverBecomesAvailableAfterRequeue(resource.data.activeOrderId)))
        );
    }

    function validAuctionPrice(amount) {
      return amount is int && amount >= 500 && amount <= 1000000;
    }

    function auctionOfferDocument(offerId) {
      return /databases/$(database)/documents/auctionOffers/$(offerId);
    }

    function validOwnAuctionOffer(offerId) {
      let data = request.resource.data;
      return driverIsAvailable()
        && data.keys().hasOnly(['orderId', 'driverUid', 'driverId', 'driverName', 'driverPhone',
          'driverCar', 'driverColor', 'priceAmount', 'arrivalMinutes', 'round', 'status', 'expiresAt', 'updatedAt', 'commissionRate'])
        && data.driverUid == request.auth.uid
        && data.driverId == linkedDriverId()
        && data.orderId is string
        && offerId == data.orderId + '_' + request.auth.uid
        && get(orderDocument(data.orderId)).data.status == 'bidding'
        && get(orderDocument(data.orderId)).data.serviceType == 'auction'
        && data.round == get(orderDocument(data.orderId)).data.auctionRound
        && data.driverName == get(linkedDriverDocument()).data.get('name', 'Водитель')
        && data.driverPhone == get(linkedDriverDocument()).data.get('phone', '')
        && data.driverCar == get(linkedDriverDocument()).data.get('car', '')
        && data.driverColor == get(linkedDriverDocument()).data.get('color', '')
        && canFundOrder(get(linkedDriverDocument()).data, data.priceAmount)
        && (!hasFinanceSettings(get(linkedDriverDocument()).data) && !data.keys().hasAny(['commissionRate'])
          || data.commissionRate == get(linkedDriverDocument()).data.get('commissionRate', 20))
        && validAuctionPrice(data.priceAmount)
        && data.arrivalMinutes is int && data.arrivalMinutes >= 1 && data.arrivalMinutes <= 120
        && data.status == 'active'
        && data.expiresAt is timestamp
        && data.expiresAt > request.time
        && data.expiresAt <= request.time + duration.value(3, 'm')
        && data.updatedAt == request.time;
    }

    function validAuctionSelection(orderId, before, after) {
      let offer = get(auctionOfferDocument(after.selectedOfferId)).data;
      let accountPath = /databases/$(database)/documents/driverAccounts/$(offer.driverUid);
      let statePath = /databases/$(database)/documents/driverStates/$(offer.driverUid);
      return signedIn() && before.clientUid == request.auth.uid
        && before.serviceType == 'auction' && before.status == 'bidding'
        && after.status == 'accepted'
        && after.selectedOfferId == orderId + '_' + offer.driverUid
        && offer.orderId == orderId && offer.status == 'active'
        && offer.round == before.auctionRound && offer.expiresAt > request.time
        && get(accountPath).data.active == true && get(accountPath).data.driverId == offer.driverId
        && get(driverDocument(offer.driverId)).data.status == 'active'
        && validReservation(after, get(driverDocument(offer.driverId)).data)
        && get(statePath).data.driverId == offer.driverId
        && get(statePath).data.status == 'available' && get(statePath).data.activeOrderId == ''
        && get(statePath).data.lastSeen > request.time - duration.value(2, 'm')
        && after.assignedDriverUid == offer.driverUid && after.assignedDriverId == offer.driverId
        && after.driverName == offer.driverName && after.driverPhone == offer.driverPhone
        && after.driverCar == offer.driverCar && after.driverColor == offer.driverColor
        && after.priceAmount == offer.priceAmount && after.priceText == string(offer.priceAmount) + ' ₸'
        && after.arrivalMinutes == offer.arrivalMinutes
        && after.acceptedAt == request.time && after.updatedAt == request.time
        && after.diff(before).affectedKeys().hasOnly(['status', 'assignedDriverUid', 'assignedDriverId',
          'driverName', 'driverPhone', 'driverCar', 'driverColor', 'priceAmount', 'priceText',
          'selectedOfferId', 'arrivalMinutes', 'acceptedAt', 'updatedAt', 'commissionTerms'])
        && getAfter(statePath).data.status == 'busy' && getAfter(statePath).data.activeOrderId == orderId
        && getAfter(statePath).data.lastSeen == request.time && getAfter(statePath).data.updatedAt == request.time;
    }

    function clientReservesAuctionDriver(accountUid) {
      let orderId = request.resource.data.activeOrderId;
      return signedIn() && resource.data.status == 'available'
        && request.resource.data.status == 'busy'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'activeOrderId', 'lastSeen', 'updatedAt'])
        && getAfter(orderDocument(orderId)).data.assignedDriverUid == accountUid
        && validAuctionSelection(orderId, get(orderDocument(orderId)).data, getAfter(orderDocument(orderId)).data);
    }

    function financeSettings(data) {
      return {'commissionRate': data.get('commissionRate', 20), 'debtMode': data.get('debtMode', 'unlimited'), 'debtLimit': data.get('debtLimit', 0)};
    }

    function hasFinanceSettings(data) {
      return data.keys().hasAny(['commissionRate', 'debtMode', 'debtLimit']);
    }

    function validFinanceProfile(data) {
      return !hasFinanceSettings(data) || (data.commissionRate is int && data.commissionRate >= 0 && data.commissionRate <= 100
        && data.debtMode in ['none', 'limited', 'unlimited']
        && data.debtLimit is int && data.debtLimit >= 0 && data.debtLimit <= 10000000
        && (data.debtMode == 'limited' ? data.debtLimit > 0 : data.debtLimit == 0));
    }

    function financeAmount(price, rate) { return math.round(price * rate) / 100.0; }

    function hasOrderFunds(driver) {
      let rate = driver.get('commissionRate', 20);
      let mode = driver.get('debtMode', 'unlimited');
      let ceiling = mode == 'none' ? 0 : driver.get('debtLimit', 0);
      return mode == 'unlimited' || (rate == 0 ? driver.balance <= ceiling : driver.balance < ceiling);
    }

    function canFundOrder(driver, price) {
      let mode = driver.get('debtMode', 'unlimited');
      return driver.balance is number && price is number && price >= 0 && price <= 10000000
        && (mode == 'unlimited' || math.round((driver.balance + financeAmount(price, driver.get('commissionRate', 20))) * 100)
          <= (mode == 'none' ? 0 : driver.debtLimit * 100));
    }

    function validReservation(order, driver) {
      let terms = order.get('commissionTerms', null);
      return canFundOrder(driver, order.priceAmount)
        && ((!hasFinanceSettings(driver) && terms == null)
          || (terms is map && terms.keys().hasOnly(['rate', 'baseAmount', 'amount'])
            && terms.rate == driver.get('commissionRate', 20)
            && terms.baseAmount == order.priceAmount
            && terms.amount == financeAmount(order.priceAmount, terms.rate)));
    }

    function financialHistoryDocument(entryId) {
      return /databases/$(database)/documents/driverFinanceHistory/$(entryId);
    }

    function validFinanceAudit(driverId, before, after) {
      let history = getAfter(financialHistoryDocument(after.financeChangeId)).data;
      return !exists(financialHistoryDocument(after.financeChangeId))
        && history.keys().hasOnly(['driverId', 'previous', 'next', 'changedAt', 'changedBy'])
        && history.driverId == driverId && history.previous == before
        && history.next == financeSettings(after)
        && history.changedAt == request.time && history.changedBy == request.auth.uid;
    }

    function adminFinanceProfileCreate(driverId) {
      return validFinanceProfile(request.resource.data)
        && (!hasFinanceSettings(request.resource.data) || validFinanceAudit(driverId, null, request.resource.data));
    }

    function adminFinanceProfileUpdate(driverId) {
      return validFinanceProfile(request.resource.data)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['commissionRate', 'debtMode', 'debtLimit', 'financeChangeId'])
          || (hasFinanceSettings(request.resource.data) && validFinanceAudit(driverId, financeSettings(resource.data), request.resource.data)));
    }

    function adminReservation(orderId, order) {
      let driver = get(driverDocument(order.assignedDriverId)).data;
      let statePath = /databases/$(database)/documents/driverStates/$(order.assignedDriverUid);
      let accountPath = /databases/$(database)/documents/driverAccounts/$(order.assignedDriverUid);
      return validReservation(order, driver)
        && (!hasFinanceSettings(driver) && order.get('commissionTerms', null) == null
          || (driver.status == 'active' && get(accountPath).data.active == true && get(accountPath).data.driverId == order.assignedDriverId
            && (!exists(statePath) || (get(statePath).data.status != 'busy' && get(statePath).data.activeOrderId == ''))
            && getAfter(statePath).data.status == 'busy' && getAfter(statePath).data.activeOrderId == orderId
            && getAfter(statePath).data.driverId == order.assignedDriverId));
    }

    function adminFinanceOrderCreate(orderId) {
      let data = request.resource.data;
      return data.get('assignedDriverUid', '') == '' ? data.get('commissionTerms', null) == null : adminReservation(orderId, data);
    }

    function adminFinanceOrderUpdate(orderId) {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      let statePath = /databases/$(database)/documents/driverStates/$(before.get('assignedDriverUid', ''));
      return after.status == 'accepted' && (!activeOrderStatus(before.status) || changed.hasAny(['assignedDriverId', 'assignedDriverUid']))
        ? adminReservation(orderId, after)
        : ((!changed.hasAny(['commissionTerms', 'priceAmount']) || before.get('commissionTerms', null) == null)
          && (before.get('commissionTerms', null) == null || !activeOrderStatus(before.status) || activeOrderStatus(after.status)
            || (getAfter(statePath).data.status == 'available' && getAfter(statePath).data.activeOrderId == ''
              && (after.status != 'completed' || validCommissionSettlement(orderId, before.assignedDriverId)))));
    }

    function validVehicleProfile(data) {
      return (!data.keys().hasAny(['serviceCategories', 'passengerSeats']))
        || (data.serviceCategories is list
          && data.serviceCategories.hasAll(['sedan'])
          && data.serviceCategories.hasOnly(['sedan', 'wagon', 'minivan'])
          && data.serviceCategories.size() >= 1 && data.serviceCategories.size() <= 3
          && data.serviceCategories.toSet().size() == data.serviceCategories.size()
          && data.passengerSeats is int && data.passengerSeats >= 1 && data.passengerSeats <= 8
          && (!data.serviceCategories.hasAny(['minivan']) || data.passengerSeats >= 5));
    }

    function vehicleFitsOrder(order, driver) {
      let category = order.get('vehicleCategory', 'sedan');
      let passengers = order.get('passengerCount', 1);
      let seats = driver.get('passengerSeats', 4);
      return order.get('serviceType', 'taxi') != 'taxi'
        || (category in ['sedan', 'wagon', 'minivan']
          && (category == 'sedan' || driver.get('serviceCategories', ['sedan']).hasAny([category]))
          && passengers is int && passengers >= 1 && passengers <= seats
          && (category != 'minivan' || seats >= 5));
    }

    function validVehicleFare(data) {
      let category = data.get('vehicleCategory', 'sedan');
      let factor = category == 'wagon' ? 120 : 150;
      return !data.keys().hasAny(['vehicleCategory', 'passengerCount', 'basePriceMin', 'basePriceMax'])
        || (data.serviceType == 'taxi'
          && data.keys().hasAll(['vehicleCategory', 'passengerCount', 'basePriceMin', 'basePriceMax'])
          && category in ['sedan', 'wagon', 'minivan']
          && data.passengerCount is int && data.passengerCount >= 1 && data.passengerCount <= 8
          && data.basePriceMin is int && data.basePriceMin >= 0
          && data.basePriceMax is int && data.basePriceMax >= data.basePriceMin && data.basePriceMax <= 10000000
          && data.priceAmount is int && data.priceAmount <= 10000000
          && ((category == 'sedan' && data.priceAmount == data.basePriceMax)
            || (category != 'sedan' && data.basePriceMin > 0
              && data.priceAmount % 100 == 0
              && data.priceAmount * 100 >= data.basePriceMax * factor
              && (data.priceAmount - 100) * 100 < data.basePriceMax * factor)));
    }

    function adminAssignsSuitableVehicle(data) {
      return data.get('assignedDriverUid', '') == ''
        || vehicleFitsOrder(data, get(driverDocument(data.assignedDriverId)).data);
    }

    function validAdminCategoryUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (!changed.hasAny(['vehicleCategory', 'passengerCount', 'basePriceMin', 'basePriceMax', 'priceAmount'])
          || validVehicleFare(request.resource.data))
        && (!changed.hasAny(['assignedDriverUid', 'assignedDriverId', 'vehicleCategory', 'passengerCount'])
          || adminAssignsSuitableVehicle(request.resource.data));
    }

    function validClientOrderCreate() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'orderNumber', 'serviceType', 'source', 'clientUid',
          'fromAddress', 'toAddress', 'stops', 'wishes', 'scheduledFor',
          'direction', 'priceText', 'priceAmount', 'serviceDetails', 'status',
          'createdAt', 'updatedAt', 'proposedPrice', 'auctionRound',
          'vehicleCategory', 'passengerCount', 'basePriceMin', 'basePriceMax'
        ])
        && request.resource.data.clientUid == request.auth.uid
        && request.resource.data.serviceType in ['taxi', 'delivery', 'auction']
        && validVehicleFare(request.resource.data)
        && request.resource.data.source == 'online'
        && ((request.resource.data.serviceType == 'auction' && request.resource.data.status == 'bidding')
          || (request.resource.data.serviceType != 'auction' && request.resource.data.status == 'searching'
            && !request.resource.data.keys().hasAny(['proposedPrice', 'auctionRound'])))
        && request.resource.data.orderNumber is string
        && request.resource.data.orderNumber.size() > 0
        && request.resource.data.orderNumber.size() <= 32
        && request.resource.data.fromAddress is string
        && request.resource.data.fromAddress.size() > 0
        && request.resource.data.fromAddress.size() <= 240
        && request.resource.data.toAddress is string
        && request.resource.data.toAddress.size() > 0
        && request.resource.data.toAddress.size() <= 240
        && request.resource.data.stops is list
        && request.resource.data.stops.size() <= 5
        && request.resource.data.wishes is string
        && request.resource.data.wishes.size() <= 500
        && request.resource.data.scheduledFor is string
        && request.resource.data.scheduledFor.size() <= 40
        && request.resource.data.direction is string
        && request.resource.data.direction.size() <= 120
        && request.resource.data.priceText is string
        && request.resource.data.priceText.size() <= 80
        && request.resource.data.priceAmount is number
        && request.resource.data.priceAmount >= 0
        && request.resource.data.priceAmount <= 10000000
        && (
          (request.resource.data.serviceType == 'taxi'
            && !request.resource.data.keys().hasAny(['serviceDetails']))
          || (request.resource.data.serviceType == 'auction'
            && !request.resource.data.keys().hasAny(['serviceDetails'])
            && validAuctionPrice(request.resource.data.proposedPrice)
            && request.resource.data.priceAmount == request.resource.data.proposedPrice
            && request.resource.data.priceText == string(request.resource.data.proposedPrice) + ' ₸'
            && request.resource.data.auctionRound == 1)
          || (request.resource.data.serviceType == 'delivery'
            && request.resource.data.serviceDetails is map
            && request.resource.data.serviceDetails.keys().hasOnly(['store', 'items'])
            && request.resource.data.serviceDetails.store is string
            && request.resource.data.serviceDetails.store.size() <= 160
            && request.resource.data.serviceDetails.items is string
            && request.resource.data.serviceDetails.items.size() > 0
            && request.resource.data.serviceDetails.items.size() <= 700)
        )
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function clientCancelsOwnSearchingOrder() {
      return signedIn()
        && resource.data.clientUid == request.auth.uid
        && resource.data.status in ['searching', 'bidding']
        && request.resource.data.status == 'cancelled'
        && request.resource.data.cancelledBy == 'client'
        && request.resource.data.cancelledAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'cancelledBy', 'cancelledAt', 'updatedAt'
        ]);
    }

    function clientRequestsCancellationAfterAssignment() {
      return signedIn()
        && resource.data.clientUid == request.auth.uid
        && resource.data.status in ['accepted', 'en_route', 'arrived']
        && resource.data.assignedDriverUid is string
        && resource.data.assignedDriverUid.size() > 0
        && resource.data.get('cancellationRequestStatus', '') != 'pending'
        && request.resource.data.cancellationRequestStatus == 'pending'
        && request.resource.data.cancellationReason is string
        && request.resource.data.cancellationReason in [
          'plans_changed', 'no_longer_needed', 'called_other_taxi', 'other'
        ]
        && request.resource.data.cancellationRequestedBy == 'client'
        && request.resource.data.cancellationRequestedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'cancellationRequestStatus', 'cancellationReason', 'cancellationRequestedBy',
          'cancellationRequestedAt', 'updatedAt'
        ]);
    }

    function driverAcceptsSearchingOrder(orderId) {
      return driverIsAvailable()
        && vehicleFitsOrder(resource.data, get(linkedDriverDocument()).data)
        && validReservation(request.resource.data, get(linkedDriverDocument()).data)
        && resource.data.status == 'searching'
        && request.resource.data.status == 'accepted'
        && request.resource.data.assignedDriverUid == request.auth.uid
        && request.resource.data.assignedDriverId == linkedDriverId()
        && request.resource.data.driverName == get(linkedDriverDocument()).data.get('name', 'Водитель')
        && request.resource.data.driverPhone == get(linkedDriverDocument()).data.get('phone', '')
        && request.resource.data.driverCar == get(linkedDriverDocument()).data.get('car', '')
        && request.resource.data.driverColor == get(linkedDriverDocument()).data.get('color', '')
        && request.resource.data.acceptedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'assignedDriverUid', 'assignedDriverId',
          'driverName', 'driverPhone', 'driverCar', 'driverColor',
          'acceptedAt', 'updatedAt', 'commissionTerms'
        ])
        && driverBecomesBusyWithOrder(orderId);
    }

    function validDriverStatusTransition() {
      return (resource.data.status == 'accepted' && request.resource.data.status == 'arrived')
        || (resource.data.status == 'accepted' && request.resource.data.status == 'en_route')
        || (resource.data.status == 'en_route' && request.resource.data.status == 'arrived')
        || (resource.data.status == 'arrived' && request.resource.data.status == 'completed')
        || (resource.data.status == 'arrived' && request.resource.data.status == 'in_trip')
        || (resource.data.status == 'in_trip' && request.resource.data.status == 'completed');
    }

    function assignedDriverAdvancesOrder(orderId) {
      return driverIsBusyWithOrder(orderId)
        && resource.data.assignedDriverUid == request.auth.uid
        && resource.data.assignedDriverId == linkedDriverId()
        && resource.data.get('cancellationRequestStatus', '') != 'pending'
        && validDriverStatusTransition()
        && request.resource.data.updatedAt == request.time
        && (
          (request.resource.data.status != 'completed'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
          || (request.resource.data.status == 'completed'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'updatedAt', 'commissionRate', 'commissionAmount',
              'commissionBaseAmount', 'commissionBalanceBefore', 'commissionBalanceAfter', 'commissionChargedAt'
            ])
            && validCommissionSettlement(orderId, linkedDriverId())
            && driverBecomesAvailableAfter(orderId))
        );
    }

    function requeueableDriverOrderStatus(status) {
      return status == 'accepted'
        || status == 'en_route'
        || status == 'arrived';
    }

    function assignedDriverReturnsOrderToSearch(orderId) {
      return driverIsBusyWithOrder(orderId)
        && resource.data.assignedDriverUid == request.auth.uid
        && resource.data.assignedDriverId == linkedDriverId()
        && resource.data.get('cancellationRequestStatus', '') != 'pending'
        && requeueableDriverOrderStatus(resource.data.status)
        && ((resource.data.get('auctionRound', 0) > 0
            && request.resource.data.status == 'bidding'
            && request.resource.data.auctionRound == resource.data.auctionRound + 1
            && request.resource.data.selectedOfferId == ''
            && request.resource.data.arrivalMinutes == 0
            && request.resource.data.priceAmount == resource.data.proposedPrice
            && request.resource.data.priceText == string(resource.data.proposedPrice) + ' ₸')
          || (resource.data.get('auctionRound', 0) == 0
            && request.resource.data.status == 'searching'
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['auctionRound', 'selectedOfferId', 'arrivalMinutes', 'priceAmount', 'priceText'])))
        && request.resource.data.assignedDriverUid == ''
        && request.resource.data.assignedDriverId == ''
        && request.resource.data.driverName == ''
        && request.resource.data.driverPhone == ''
        && request.resource.data.driverCar == ''
        && request.resource.data.driverColor == ''
        && request.resource.data.get('commissionTerms', null) == null
        && request.resource.data.requeueReason is string
        && request.resource.data.requeueReason in ['car_issue', 'cannot_continue', 'other']
        && request.resource.data.requeuedBy == 'driver'
        && request.resource.data.requeuedByDriverId == linkedDriverId()
        && request.resource.data.requeuedAt == request.time
        && request.resource.data.requeueCount is number
        && request.resource.data.requeueCount == resource.data.get('requeueCount', 0) + 1
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'assignedDriverUid', 'assignedDriverId',
          'driverName', 'driverPhone', 'driverCar', 'driverColor',
          'requeueReason', 'requeuedBy', 'requeuedByDriverId', 'requeuedAt', 'requeueCount', 'updatedAt',
          'auctionRound', 'selectedOfferId', 'arrivalMinutes', 'priceAmount', 'priceText', 'commissionTerms'
        ])
        && driverBecomesAvailableAfterRequeue(orderId);
    }

    function validClientContactCreate(orderId) {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'clientUid', 'customerName', 'customerPhone', 'passengerPhone',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.clientUid == request.auth.uid
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 80
        && request.resource.data.customerPhone is string
        && request.resource.data.customerPhone.size() >= 10
        && request.resource.data.customerPhone.size() <= 32
        && request.resource.data.passengerPhone is string
        && request.resource.data.passengerPhone.size() <= 32
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(orderDocument(orderId))
        && getAfter(orderDocument(orderId)).data.clientUid == request.auth.uid;
    }

    function validDriverMessageData(data) {
      return data.keys().hasOnly([
          'driverUid', 'driverId', 'driverName', 'driverCar', 'sender',
          'text', 'createdAt', 'readByDispatcher', 'dispatcherReadAt'
        ])
        && data.driverUid is string
        && data.driverUid.size() > 0
        && data.driverUid.size() <= 128
        && data.driverId is string
        && data.driverId.size() > 0
        && data.driverId.size() <= 128
        && data.driverName is string
        && data.driverName.size() > 0
        && data.driverName.size() <= 80
        && data.driverCar is string
        && data.driverCar.size() <= 160
        && data.sender is string
        && data.sender in ['driver', 'dispatcher']
        && data.text is string
        && data.text.size() > 0
        && data.text.size() <= 500
        && data.createdAt == request.time
        && data.readByDispatcher is bool;
    }

    function validOwnDriverMessageCreate() {
      return hasDriverAccount()
        && exists(linkedDriverDocument())
        && validDriverMessageData(request.resource.data)
        && request.resource.data.driverUid == request.auth.uid
        && request.resource.data.driverId == linkedDriverId()
        && request.resource.data.driverName == get(linkedDriverDocument()).data.get('name', 'Водитель')
        && request.resource.data.driverCar == get(linkedDriverDocument()).data.get('car', '')
        && request.resource.data.sender == 'driver'
        && request.resource.data.readByDispatcher == false
        && request.resource.data.dispatcherReadAt == null;
    }

    function validAdminDriverMessageCreate() {
      return isAdmin()
        && validDriverMessageData(request.resource.data)
        && request.resource.data.sender == 'dispatcher'
        && request.resource.data.readByDispatcher == true
        && request.resource.data.dispatcherReadAt == request.time;
    }

    function adminMarksDriverMessageRead() {
      return isAdmin()
        && resource.data.sender == 'driver'
        && resource.data.readByDispatcher == false
        && request.resource.data.readByDispatcher == true
        && request.resource.data.dispatcherReadAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'readByDispatcher', 'dispatcherReadAt'
        ]);
    }

    // Первую запись администратора владелец проекта создаёт вручную в консоли.
    // Клиентский сайт не может назначить администратора сам себе.
    match /admins/{adminId} {
      allow read: if signedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if false;
    }

    match /drivers/{driverId} {
      allow read: if isAdmin() || isLinkedDriver(driverId);
      allow create: if isAdmin() && validVehicleProfile(request.resource.data) && adminFinanceProfileCreate(driverId);
      allow delete: if isAdmin();
      allow update: if (isAdmin() && validVehicleProfile(request.resource.data) && adminFinanceProfileUpdate(driverId)) || driverAppliesOwnOnlineCommission(driverId);
    }

    match /driverAccounts/{accountUid} {
      allow read: if signedIn() && (request.auth.uid == accountUid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // Один документ — одно устройство водителя. Сам водитель не читает токен,
    // а только обновляет его при разрешении системных уведомлений.
    match /driverPushTokens/{tokenId} {
      allow read: if isAdmin();
      allow create: if hasDriverAccount()
        && request.resource.data.keys().hasOnly(['uid', 'driverId', 'token', 'enabled', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.driverId == linkedDriverId()
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0
        && request.resource.data.token.size() <= 4096
        && request.resource.data.enabled is bool
        && request.resource.data.updatedAt == request.time;
      allow update: if hasDriverAccount()
        && resource.data.uid == request.auth.uid
        && resource.data.driverId == linkedDriverId()
        && request.resource.data.keys().hasOnly(['uid', 'driverId', 'token', 'enabled', 'updatedAt'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.driverId == resource.data.driverId
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0
        && request.resource.data.token.size() <= 4096
        && request.resource.data.enabled is bool
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['token', 'enabled', 'updatedAt']);
      allow delete: if hasDriverAccount()
        && resource.data.uid == request.auth.uid
        && resource.data.driverId == linkedDriverId();
    }

    match /driverStates/{accountUid} {
      allow read: if signedIn() && (request.auth.uid == accountUid || isAdmin());
      allow create: if isAdmin()
        || (signedIn() && request.auth.uid == accountUid && validOwnDriverStateCreate());
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == accountUid && validOwnDriverStateUpdate())
        || clientReservesAuctionDriver(accountUid);
      allow delete: if isAdmin();
    }

    match /driverFinanceHistory/{entryId} {
      allow read: if isAdmin() || isLinkedDriver(resource.data.driverId);
      allow create: if isAdmin()
        && getAfter(driverDocument(request.resource.data.driverId)).data.financeChangeId == entryId
        && validFinanceAudit(request.resource.data.driverId,
          exists(driverDocument(request.resource.data.driverId)) ? financeSettings(get(driverDocument(request.resource.data.driverId)).data) : null,
          getAfter(driverDocument(request.resource.data.driverId)).data);
      allow update, delete: if false;
    }

    match /balanceHistory/{entryId} {
      // Перед завершением водитель читает документ с ID заказа, чтобы не списать
      // комиссию дважды. Разрешаем отсутствие только для своего текущего заказа.
      allow get: if isAdmin()
        || (hasDriverAccount()
          && (
            (exists(onlineCommissionHistoryDocument(entryId))
              && resource.data.driverId == linkedDriverId())
            || (!exists(onlineCommissionHistoryDocument(entryId))
              && driverIsBusyWithOrder(entryId)
              && exists(orderDocument(entryId))
              && get(orderDocument(entryId)).data.assignedDriverUid == request.auth.uid
              && get(orderDocument(entryId)).data.assignedDriverId == linkedDriverId()
              && get(orderDocument(entryId)).data.status in ['arrived', 'in_trip'])
          ));
      allow list: if isAdmin()
        || (hasDriverAccount() && resource.data.driverId == linkedDriverId());
      allow create: if isAdmin() || (signedIn() && validOwnOnlineCommissionHistoryCreate(entryId));
      allow update, delete: if false;
    }

    match /driverMessages/{messageId} {
      allow read: if isAdmin()
        || (hasDriverAccount()
          && resource.data.driverUid == request.auth.uid
          && resource.data.driverId == linkedDriverId());
      allow create: if validOwnDriverMessageCreate() || validAdminDriverMessageCreate();
      allow update: if adminMarksDriverMessageRead();
      allow delete: if false;
    }

    match /settings/{settingId} {
      allow read: if isAdmin() || (settingId == 'driverPortal' && mayOpenOrders());
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if (isAdmin() && validVehicleFare(request.resource.data) && adminAssignsSuitableVehicle(request.resource.data) && adminFinanceOrderCreate(orderId)) || validClientOrderCreate();
      allow read: if isAdmin()
        || (signedIn() && resource.data.clientUid == request.auth.uid)
        || (driverIsAvailable() && resource.data.status in ['searching', 'bidding'])
        || (signedIn() && resource.data.get('assignedDriverUid', '') == request.auth.uid);
      allow update: if (isAdmin() && validAdminCategoryUpdate() && adminFinanceOrderUpdate(orderId))
        || (resource.data.clientUid == request.auth.uid
          && (clientCancelsOwnSearchingOrder() || clientRequestsCancellationAfterAssignment()))
        || (resource.data.status == 'bidding' && request.resource.data.status == 'accepted'
          && validAuctionSelection(orderId, resource.data, request.resource.data))
        || (resource.data.status == 'searching' && request.resource.data.status == 'accepted'
          && driverAcceptsSearchingOrder(orderId))
        || (resource.data.get('assignedDriverUid', '') == request.auth.uid
          && ((request.resource.data.status in ['searching', 'bidding'] && assignedDriverReturnsOrderToSearch(orderId))
            || (!(request.resource.data.status in ['searching', 'bidding']) && assignedDriverAdvancesOrder(orderId))));
      allow delete: if isAdmin();
    }

    match /auctionOffers/{offerId} {
      allow read: if isAdmin() || (signedIn() && (resource.data.driverUid == request.auth.uid
        || get(orderDocument(resource.data.orderId)).data.clientUid == request.auth.uid));
      allow create: if validOwnAuctionOffer(offerId);
      allow update: if signedIn() && resource.data.driverUid == request.auth.uid
        && (validOwnAuctionOffer(offerId)
          || (request.resource.data.status == 'withdrawn' && request.resource.data.updatedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])));
      allow delete: if false;
    }

    match /orderContacts/{orderId} {
      allow create: if isAdmin() || validClientContactCreate(orderId);
      allow read: if isAdmin()
        || (signedIn() && resource.data.clientUid == request.auth.uid)
        || (signedIn()
          && exists(orderDocument(orderId))
          && get(orderDocument(orderId)).data.get('assignedDriverUid', '') == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
