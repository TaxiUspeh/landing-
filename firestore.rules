rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminDocument() {
      return /databases/$(database)/documents/admins/$(request.auth.uid);
    }

    function isAdmin() {
      return signedIn()
        && exists(adminDocument())
        && get(adminDocument()).data.active == true;
    }

    function driverAccountDocument() {
      return /databases/$(database)/documents/driverAccounts/$(request.auth.uid);
    }

    function driverStateDocument() {
      return /databases/$(database)/documents/driverStates/$(request.auth.uid);
    }

    function hasDriverAccount() {
      return signedIn() && exists(driverAccountDocument());
    }

    function linkedDriverId() {
      return get(driverAccountDocument()).data.driverId;
    }

    function isLinkedDriver(driverId) {
      return hasDriverAccount() && linkedDriverId() == driverId;
    }

    function linkedDriverDocument() {
      return /databases/$(database)/documents/drivers/$(linkedDriverId());
    }

    function mayOpenOrders() {
      return hasDriverAccount()
        && get(driverAccountDocument()).data.active == true
        && exists(linkedDriverDocument())
        && get(linkedDriverDocument()).data.status == 'active'
        && get(linkedDriverDocument()).data.balance is number
        && get(linkedDriverDocument()).data.balance < 0;
    }

    function activeOrderStatus(status) {
      return status == 'accepted'
        || status == 'en_route'
        || status == 'arrived'
        || status == 'in_trip';
    }

    function driverIsAvailable() {
      return mayOpenOrders()
        && exists(driverStateDocument())
        && get(driverStateDocument()).data.driverId == linkedDriverId()
        && get(driverStateDocument()).data.status == 'available'
        && get(driverStateDocument()).data.activeOrderId == ''
        && get(driverStateDocument()).data.lastSeen is timestamp
        && get(driverStateDocument()).data.lastSeen >= request.time - duration.value(3, 'm');
    }

    function driverIsBusyWithOrder(orderId) {
      return hasDriverAccount()
        && exists(driverStateDocument())
        && get(driverStateDocument()).data.driverId == linkedDriverId()
        && get(driverStateDocument()).data.status == 'busy'
        && get(driverStateDocument()).data.activeOrderId == orderId;
    }

    function driverBecomesBusyWithOrder(orderId) {
      return existsAfter(driverStateDocument())
        && getAfter(driverStateDocument()).data.driverId == linkedDriverId()
        && getAfter(driverStateDocument()).data.status == 'busy'
        && getAfter(driverStateDocument()).data.activeOrderId == orderId
        && getAfter(driverStateDocument()).data.lastSeen == request.time
        && getAfter(driverStateDocument()).data.updatedAt == request.time;
    }

    function driverBecomesAvailableAfter(orderId) {
      return existsAfter(driverStateDocument())
        && getAfter(driverStateDocument()).data.driverId == linkedDriverId()
        && getAfter(driverStateDocument()).data.status == 'available'
        && getAfter(driverStateDocument()).data.activeOrderId == ''
        && getAfter(driverStateDocument()).data.lastSeen == request.time
        && getAfter(driverStateDocument()).data.updatedAt == request.time
        && existsAfter(orderDocument(orderId))
        && (getAfter(orderDocument(orderId)).data.status == 'completed'
          || getAfter(orderDocument(orderId)).data.status == 'cancelled');
    }

    function orderDocument(orderId) {
      return /databases/$(database)/documents/orders/$(orderId);
    }

    function validDriverStateData(data) {
      return data.keys().hasOnly([
          'driverId', 'status', 'activeOrderId', 'lastSeen', 'updatedAt'
        ])
        && data.driverId is string
        && data.driverId == linkedDriverId()
        && data.status is string
        && data.status in ['offline', 'available', 'busy']
        && data.activeOrderId is string
        && data.activeOrderId.size() <= 128
        && ((data.status == 'busy' && data.activeOrderId.size() > 0)
          || (data.status != 'busy' && data.activeOrderId == ''))
        && data.lastSeen == request.time
        && data.updatedAt == request.time;
    }

    function validOwnDriverStateCreate() {
      return hasDriverAccount()
        && validDriverStateData(request.resource.data)
        && (request.resource.data.status == 'offline'
          || (request.resource.data.status == 'available' && mayOpenOrders())
          || (request.resource.data.status == 'busy'
            && exists(orderDocument(request.resource.data.activeOrderId))
            && get(orderDocument(request.resource.data.activeOrderId)).data.assignedDriverUid == request.auth.uid
            && activeOrderStatus(get(orderDocument(request.resource.data.activeOrderId)).data.status)));
    }

    function validOwnDriverStateUpdate() {
      return hasDriverAccount()
        && resource.data.driverId == linkedDriverId()
        && validDriverStateData(request.resource.data)
        && (
          (request.resource.data.status == resource.data.status
            && request.resource.data.activeOrderId == resource.data.activeOrderId
            && (resource.data.status != 'available' || mayOpenOrders()))
          || (resource.data.status == 'offline'
            && request.resource.data.status == 'available'
            && mayOpenOrders())
          || (resource.data.status == 'available'
            && request.resource.data.status == 'offline')
          || (resource.data.status == 'available'
            && resource.data.activeOrderId == ''
            && request.resource.data.status == 'busy'
            && existsAfter(orderDocument(request.resource.data.activeOrderId))
            && getAfter(orderDocument(request.resource.data.activeOrderId)).data.assignedDriverUid == request.auth.uid
            && activeOrderStatus(getAfter(orderDocument(request.resource.data.activeOrderId)).data.status))
          || (resource.data.status == 'busy'
            && request.resource.data.status == 'available'
            && request.resource.data.activeOrderId == ''
            && existsAfter(orderDocument(resource.data.activeOrderId))
            && (getAfter(orderDocument(resource.data.activeOrderId)).data.status == 'completed'
              || getAfter(orderDocument(resource.data.activeOrderId)).data.status == 'cancelled'))
        );
    }

    function validClientOrderCreate() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'orderNumber', 'serviceType', 'source', 'clientUid',
          'fromAddress', 'toAddress', 'stops', 'wishes', 'scheduledFor',
          'direction', 'priceText', 'priceAmount', 'status',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.clientUid == request.auth.uid
        && request.resource.data.serviceType == 'taxi'
        && request.resource.data.source == 'online'
        && request.resource.data.status == 'searching'
        && request.resource.data.orderNumber is string
        && request.resource.data.orderNumber.size() > 0
        && request.resource.data.orderNumber.size() <= 32
        && request.resource.data.fromAddress is string
        && request.resource.data.fromAddress.size() > 0
        && request.resource.data.fromAddress.size() <= 240
        && request.resource.data.toAddress is string
        && request.resource.data.toAddress.size() > 0
        && request.resource.data.toAddress.size() <= 240
        && request.resource.data.stops is list
        && request.resource.data.stops.size() <= 5
        && request.resource.data.wishes is string
        && request.resource.data.wishes.size() <= 500
        && request.resource.data.scheduledFor is string
        && request.resource.data.scheduledFor.size() <= 40
        && request.resource.data.direction is string
        && request.resource.data.direction.size() <= 120
        && request.resource.data.priceText is string
        && request.resource.data.priceText.size() <= 80
        && request.resource.data.priceAmount is number
        && request.resource.data.priceAmount >= 0
        && request.resource.data.priceAmount <= 10000000
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function clientCancelsOwnSearchingOrder() {
      return signedIn()
        && resource.data.clientUid == request.auth.uid
        && resource.data.status == 'searching'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
    }

    function driverAcceptsSearchingOrder(orderId) {
      return driverIsAvailable()
        && resource.data.status == 'searching'
        && request.resource.data.status == 'accepted'
        && request.resource.data.assignedDriverUid == request.auth.uid
        && request.resource.data.assignedDriverId == linkedDriverId()
        && request.resource.data.driverName == get(linkedDriverDocument()).data.get('name', 'Водитель')
        && request.resource.data.driverPhone == get(linkedDriverDocument()).data.get('phone', '')
        && request.resource.data.driverCar == get(linkedDriverDocument()).data.get('car', '')
        && request.resource.data.driverColor == get(linkedDriverDocument()).data.get('color', '')
        && request.resource.data.acceptedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'assignedDriverUid', 'assignedDriverId',
          'driverName', 'driverPhone', 'driverCar', 'driverColor',
          'acceptedAt', 'updatedAt'
        ])
        && driverBecomesBusyWithOrder(orderId);
    }

    function validDriverStatusTransition() {
      return (resource.data.status == 'accepted' && request.resource.data.status == 'en_route')
        || (resource.data.status == 'en_route' && request.resource.data.status == 'arrived')
        || (resource.data.status == 'arrived' && request.resource.data.status == 'in_trip')
        || (resource.data.status == 'in_trip' && request.resource.data.status == 'completed');
    }

    function assignedDriverAdvancesOrder(orderId) {
      return driverIsBusyWithOrder(orderId)
        && resource.data.assignedDriverUid == request.auth.uid
        && resource.data.assignedDriverId == linkedDriverId()
        && validDriverStatusTransition()
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && (request.resource.data.status != 'completed'
          || driverBecomesAvailableAfter(orderId));
    }

    function validClientContactCreate(orderId) {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'clientUid', 'customerName', 'customerPhone', 'passengerPhone',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.clientUid == request.auth.uid
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 80
        && request.resource.data.customerPhone is string
        && request.resource.data.customerPhone.size() >= 10
        && request.resource.data.customerPhone.size() <= 32
        && request.resource.data.passengerPhone is string
        && request.resource.data.passengerPhone.size() <= 32
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && existsAfter(orderDocument(orderId))
        && getAfter(orderDocument(orderId)).data.clientUid == request.auth.uid;
    }

    // Первую запись администратора владелец проекта создаёт вручную в консоли.
    // Клиентский сайт не может назначить администратора сам себе.
    match /admins/{adminId} {
      allow read: if signedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if false;
    }

    match /drivers/{driverId} {
      allow read: if isAdmin() || isLinkedDriver(driverId);
      allow create, update, delete: if isAdmin();
    }

    match /driverAccounts/{accountUid} {
      allow read: if signedIn() && (request.auth.uid == accountUid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /driverStates/{accountUid} {
      allow read: if signedIn() && (request.auth.uid == accountUid || isAdmin());
      allow create: if isAdmin()
        || (signedIn() && request.auth.uid == accountUid && validOwnDriverStateCreate());
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == accountUid && validOwnDriverStateUpdate());
      allow delete: if isAdmin();
    }

    match /balanceHistory/{entryId} {
      allow read: if isAdmin()
        || (hasDriverAccount() && resource.data.driverId == linkedDriverId());
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /settings/{settingId} {
      allow read: if isAdmin() || (settingId == 'driverPortal' && mayOpenOrders());
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if isAdmin() || validClientOrderCreate();
      allow read: if isAdmin()
        || (signedIn() && resource.data.clientUid == request.auth.uid)
        || (driverIsAvailable() && resource.data.status == 'searching')
        || (signedIn() && resource.data.get('assignedDriverUid', '') == request.auth.uid);
      allow update: if isAdmin()
        || clientCancelsOwnSearchingOrder()
        || driverAcceptsSearchingOrder(orderId)
        || assignedDriverAdvancesOrder(orderId);
      allow delete: if isAdmin();
    }

    match /orderContacts/{orderId} {
      allow create: if isAdmin() || validClientContactCreate(orderId);
      allow read: if isAdmin()
        || (signedIn() && resource.data.clientUid == request.auth.uid)
        || (signedIn()
          && exists(orderDocument(orderId))
          && get(orderDocument(orderId)).data.get('assignedDriverUid', '') == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
